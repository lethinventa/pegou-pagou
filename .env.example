# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key: acesso total ao banco, ignora RLS. Fica só no servidor,
# nunca prefixar com NEXT_PUBLIC_ e nunca importar em componente client.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modelo Flash a usar em /api/identify-product. Ver README para como conferir
# o nome atual no console (isso muda com frequência).
GEMINI_MODEL=gemini-3.5-flash
